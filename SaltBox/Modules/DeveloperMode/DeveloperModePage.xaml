<Page x:Class="SaltBox.Modules.DeveloperMode.DeveloperModePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="36,36,36,24">
            <TextBlock Text="{x:Bind ViewModel.Lang.DevLogsTitle, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="0">
                <controls:SettingsExpander Header="{x:Bind ViewModel.Lang.DevLogLevel, Mode=OneWay}"
                                           IsExpanded="False">

                    <ComboBox ItemsSource="{x:Bind ViewModel.LogLevels, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedMinLevel, Mode=TwoWay}"
                              MinWidth="120" />

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind ViewModel.Lang.DevCopyLogs, Mode=OneWay}"
                                               Description="{x:Bind ViewModel.Lang.DevCopyLogsDesc, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.CopyLogsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.Lang.CommonCopy, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ExportLogsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.Lang.CommonExport, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="{x:Bind ViewModel.Lang.DevOpenLogDir, Mode=OneWay}"
                                               Description="{x:Bind ViewModel.Lang.DevOpenLogDirDesc, Mode=OneWay}">
                            <Button Command="{x:Bind ViewModel.OpenLogFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.Lang.CommonOpenFolder, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <InfoBar Severity="{x:Bind ViewModel.ExportResultSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.ExportStatusText, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.IsExportResultVisible, Mode=TwoWay}"
                         IsClosable="True" />
            </StackPanel>
            
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <Grid>
                    <ScrollViewer x:Name="LogScrollViewer"
                                  MaxHeight="600"
                                  IsTabStop="True">
                        <TextBox Text="{x:Bind ViewModel.FullLogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 IsTabStop="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Top"
                                 Padding="12" />
                    </ScrollViewer>

                    <Button Command="{x:Bind ViewModel.ScrollToBottomCommand}"
                            Visibility="{x:Bind ViewModel.ScrollToBottomVisible, Mode=OneWay}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,16,16"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74B;" FontSize="12" />
                            <TextBlock Text="回到底部" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
