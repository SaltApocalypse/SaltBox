<Page
    x:Class="SaltBox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SaltBox.Views"
    xmlns:vm="using:SaltBox.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="36,36,36,24">

            <controls:SettingsCard
                Header="{x:Bind ViewModel.Lang.SettingsTheme, Mode=OneWay}"
                Description="{x:Bind ViewModel.Lang.SettingsThemeDescription, Mode=OneWay}">
                <ComboBox
                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                    MinWidth="160"
                    HorizontalAlignment="Right">
                    <ComboBoxItem Content="{x:Bind ViewModel.Lang.SettingsThemeSystem, Mode=OneWay}" />
                    <ComboBoxItem Content="{x:Bind ViewModel.Lang.SettingsThemeDark, Mode=OneWay}" />
                    <ComboBoxItem Content="{x:Bind ViewModel.Lang.SettingsThemeLight, Mode=OneWay}" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="{x:Bind ViewModel.Lang.SettingsLanguage, Mode=OneWay}"
                Description="{x:Bind ViewModel.Lang.SettingsLanguageDescription, Mode=OneWay}">
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    MinWidth="160"
                    HorizontalAlignment="Right" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="{x:Bind ViewModel.Lang.SettingsAppVersion, Mode=OneWay}"
                Description="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>
