<Page
    x:Class="SaltBox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SaltBox.Views"
    xmlns:vm="using:SaltBox.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="36,36,36,24">

            <controls:SettingsCard
                Header="{x:Bind ViewModel.Lang.SettingsTheme, Mode=OneWay}"
                Description="{x:Bind ViewModel.Lang.SettingsThemeDescription, Mode=OneWay}">
                <ComboBox
                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                    MinWidth="160"
                    HorizontalAlignment="Right">
                    <ComboBoxItem Content="{x:Bind ViewModel.Lang.SettingsThemeSystem, Mode=OneWay}" />
                    <ComboBoxItem Content="{x:Bind ViewModel.Lang.SettingsThemeDark, Mode=OneWay}" />
                    <ComboBoxItem Content="{x:Bind ViewModel.Lang.SettingsThemeLight, Mode=OneWay}" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="{x:Bind ViewModel.Lang.SettingsLanguage, Mode=OneWay}"
                Description="{x:Bind ViewModel.Lang.SettingsLanguageDescription, Mode=OneWay}">
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    MinWidth="160"
                    HorizontalAlignment="Right" />
            </controls:SettingsCard>

            <controls:SettingsExpander
                Header="{x:Bind ViewModel.Lang.SettingsCurrentVersion, Mode=OneWay}"
                Description="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="{x:Bind ViewModel.Lang.SettingsUpdateCheck, Mode=OneWay}"
                        Description="{x:Bind ViewModel.UpdateStatusDescription, Mode=OneWay}">
                        <Button
                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                            Content="{x:Bind ViewModel.Lang.SettingsUpdateCheckManual, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanCheckUpdate, Mode=OneWay}" />
                    </controls:SettingsCard>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowUpdateInfoBar, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.UpdateInfoBarSeverity, Mode=OneWay}"
                        Message="{x:Bind ViewModel.UpdateInfoBarMessage, Mode=OneWay}"
                        IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button
                                Command="{x:Bind ViewModel.DownloadAndInstallCommand}"
                                Content="{x:Bind ViewModel.Lang.SettingsUpdateNowButton, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowUpdateActionButton, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</Page>
