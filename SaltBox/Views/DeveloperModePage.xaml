<Page x:Class="SaltBox.Views.DeveloperModePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:models="using:SaltBox.Models">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="36,36,36,24">
            <TextBlock Text="{x:Bind ViewModel.Lang.DevLogsTitle, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <controls:SettingsCard Header="{x:Bind ViewModel.Lang.DevLogLevel, Mode=OneWay}">
                <ComboBox ItemsSource="{x:Bind ViewModel.LogLevels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedMinLevel, Mode=TwoWay}"
                          MinWidth="120" />
            </controls:SettingsCard>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8">
                <ScrollViewer MaxHeight="600" IsTabStop="True">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LogEntries, Mode=OneWay}"
                                  FontFamily="Consolas"
                                  FontSize="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntry">
                                <TextBlock TextWrapping="Wrap" Padding="0,1,4,1">
                                    <Run Text="{x:Bind FormattedTimestamp, Mode=OneWay}"
                                         Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <Run Text=" " />
                                    <Run Text="{x:Bind FormattedLevel, Mode=OneWay}"
                                         Foreground="{x:Bind LevelColor, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{x:Bind Message, Mode=OneWay}"
                                         Foreground="{x:Bind LevelColor, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
