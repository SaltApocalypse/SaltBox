<Page
    x:Class="SaltBox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SaltBox.Views"
    xmlns:vm="using:SaltBox.ViewModels">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <SymbolIcon
                Symbol="Home"
                Width="64"
                Height="64"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="{x:Bind ViewModel.Lang.HomeTitle, Mode=OneWay}"
                FontSize="28"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="{x:Bind ViewModel.Lang.HomeSubtitle, Mode=OneWay}"
                FontSize="14"
                HorizontalAlignment="Center"
                Opacity="0.6" />

            <Button
                Content="{x:Bind ViewModel.Lang.HomeToolsButton, Mode=OneWay}"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Click="OnToolsClick" />
        </StackPanel>
    </Grid>
</Page>
