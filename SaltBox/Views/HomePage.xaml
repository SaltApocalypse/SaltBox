<Page
    x:Class="SaltBox.Views.HomePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SaltBox.Views"
    xmlns:vm="using:SaltBox.ViewModels"
    xmlns:keycap="using:SaltBox.Controls">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="36,36,36,24">

            <TextBlock
                Text="{x:Bind ViewModel.Lang.NavTools, Mode=OneWay}"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding ElementName=RootPage, Path=ViewModel.NavigateCommand}"
                            CommandParameter="{Binding NavigateTag}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="16,12"
                            MinHeight="56">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Text="{Binding Name}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ItemsControl
                                    Grid.Column="1"
                                    ItemsSource="{Binding ShortcutKeys}"
                                    VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <keycap:KeyCap KeyText="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
